{
  "name": "quangtu-cloudflare-worker",
  "version": "1.2.26",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prebuild": "node scripts/i18n/build-english-pack-manifest.mjs",
    "build": "svelte-kit sync && vite build --config vite.config.ts",
    "build:mobile": "node scripts/build-mobile.mjs",
    "build:android": "node scripts/build-mobile.mjs --platform android",
    "postinstall": "node scripts/patch-google-auth.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "node scripts/dev/start-sveltekit-local.mjs",
    "dev:production-remote": "node scripts/dev/start-sveltekit-production-remote.mjs",
    "dev:vite": "vite dev --config vite.config.ts --host 127.0.0.1 --port 4173",
    "worktree:setup": "npm ci --no-audit --no-fund",
    "environment:start": "node scripts/worktree/start-worktree.mjs local",
    "environment:start:remote": "node scripts/worktree/start-worktree.mjs production-remote",
    "environment:stop": "node scripts/worktree/stop-worktree.mjs",
    "worktree:cleanup": "node scripts/worktree/stop-worktree.mjs --cleanup",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1 --port 4173",
    "test": "npm run test:core",
    "test:migration": "vitest run --config tests/migration/vitest.config.js",
    "test:deployment": "vitest run --config tests/deployment/vitest.config.ts",
    "test:api": "vitest run --config tests/api/vitest.config.js",
    "test:auth": "vitest run --config tests/auth/vitest.config.js",
    "test:e2e:list": "playwright test --list --config tests/e2e/playwright.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:jobs": "vitest run --config src/jobs/vitest.config.ts",
    "test:parity": "vitest run --config tests/parity/vitest.config.ts",
    "test:pwa": "vitest run --config tests/pwa/vitest.config.ts",
    "test:server": "vitest run --config tests/server/vitest.config.js",
    "test:unit": "vitest run --config tests/unit/vitest.config.ts",
    "test:core": "npm run check && npm run build && npm run test:migration && npm run test:parity && npm run test:unit && npm run test:copying-editor && npm run test:auth && npm run test:api && npm run test:server && npm run test:pwa && npm run test:jobs && npm run test:deployment && npm run test:worker",
    "test:release": "npm run test:core && npm run test:e2e",
    "test:worker": "vitest run --config vitest.config.js",
    "test:watch": "vitest",
    "verify:production": "node scripts/deploy/verify-sveltekit-production.js https://quangtu.vn",
    "verify:production-ownership": "node scripts/deploy/verify-jobs-ownership.js production deployed",
    "verify:release-preflight": "node scripts/deploy/release-preflight.js",
    "backup:production": "node scripts/deploy/backup-production-d1.js",
    "migrate:production": "node scripts/deploy/migrate-production.js",
    "deploy:production": "node scripts/require-production-approval.js && npm run verify:production-ownership && npm run migrate:production && npm run build && wrangler deploy --config wrangler.sveltekit.jsonc --env production",
    "deploy:jobs:production": "node scripts/require-production-approval.js && npm run verify:production-ownership && npm run migrate:production && wrangler deploy --config wrangler.jobs.jsonc --env production",
    "test:copying-editor": "vitest run --config tests/component/practice/vitest.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.13.3",
    "jsdom": "^16.7.0",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "typescript": "5.9.3",
    "vite": "8.0.9",
    "vitest": "4.1.10",
    "wrangler": "4.127.0"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/facebook-login": "^7.0.1",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/status-bar": "^7.0.3",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@icons-pack/svelte-simple-icons": "7.2.0",
    "@lucide/svelte": "1.29.0",
    "@tanstack/svelte-query": "6.1.46",
    "pdfjs-dist": "6.2.108"
  }
}
