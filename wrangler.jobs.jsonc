{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "ec98af014ed5d40aa1c939d19c18aaf1",
  "name": "quangtu-jobs-local",
  "main": "src/jobs/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quangtu-db-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "quangtu-local"
    }
  ],
  "vars": {
    "ENV": "local",
    "JOBS_ENABLED": "false",
    "WORKER_NAME": "quangtu-jobs-local",
    "FACEBOOK_GRAPH_API_VERSION": "v26.0",
    "FACEBOOK_IMPORT_ENABLED": "false",
    "FACEBOOK_IMPORT_MAX_PAGES": "4",
    "FACEBOOK_RECONCILE_BATCH": "10",
    "FACEBOOK_TOKEN_KEY_VERSION": "v1"
  },
  "env": {
    "production": {
      "name": "quangtu-jobs",
      "workers_dev": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "triggers": {
        "crons": ["17 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "quangtu-db",
          "database_id": "74cbd98d-c702-4243-af99-3af4a0b399c1",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "quangtu"
        }
      ],
      "secrets": {
        "required": []
      },
      "vars": {
        "ENV": "production",
        "JOBS_ENABLED": "true",
        "WORKER_NAME": "quangtu-jobs",
        "FACEBOOK_GRAPH_API_VERSION": "v26.0",
        "FACEBOOK_IMPORT_ENABLED": "false",
        "FACEBOOK_IMPORT_MAX_PAGES": "4",
        "FACEBOOK_RECONCILE_BATCH": "10",
        "FACEBOOK_TOKEN_KEY_VERSION": "v1"
      }
    }
  }
}
