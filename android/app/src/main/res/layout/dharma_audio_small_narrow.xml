<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dharma_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/dharma_audio_background">
    <TextView android:id="@+id/dharma_small_label" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/dharma_audio_name" android:textSize="12sp" android:textStyle="bold"
        android:textColor="@color/dharma_audio_text" android:includeFontPadding="false" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginTop="4dp">
        <ImageView android:id="@+id/dharma_cover" android:visibility="gone" android:layout_width="42dp" android:layout_height="42dp"
            android:background="@drawable/dharma_audio_cover_frame" android:scaleType="centerCrop" android:clipToOutline="true" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" android:importantForAccessibility="no" />
        <ImageButton android:id="@+id/dharma_play" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/dharma_audio_button" android:padding="12dp" android:src="@drawable/dharma_audio_play"
            android:contentDescription="@string/dharma_audio_play" />
    </LinearLayout>
    <TextView android:id="@+id/dharma_title" android:text="@string/dharma_audio_loading" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/dharma_audio_text"
        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/dharma_status" android:visibility="gone" android:text="@string/dharma_audio_waiting" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="@color/dharma_audio_secondary" android:includeFontPadding="false"
        android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/dharma_times" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="10sp" android:textColor="@color/dharma_audio_secondary"
        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>


