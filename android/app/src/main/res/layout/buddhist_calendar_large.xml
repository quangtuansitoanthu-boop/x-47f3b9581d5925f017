<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="8dp"
  android:background="@drawable/calendar_widget_background">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical">
    <ImageView
      android:id="@+id/widget_title_icon"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:importantForAccessibility="no"
      android:layout_marginEnd="6dp" />
    <LinearLayout
      android:orientation="vertical"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1">
      <TextView android:id="@+id/widget_calendar_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/calendar_v2_text"
        android:includeFontPadding="false"
        android:text="@string/calendar_widget_title_plain"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
      <TextView
        android:id="@+id/widget_solar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/calendar_v2_secondary"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColorHint="@color/calendar_v2_secondary" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/widget_lunar_day"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="60sp"
      android:textColor="@color/calendar_v2_day"
      android:includeFontPadding="false"
      android:fontFamily="serif"
      android:textStyle="bold"
      android:gravity="center" />
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_weight="1"
      android:layout_marginStart="10dp">
      <TextView
        android:id="@+id/widget_lunar_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/calendar_v2_text"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
      <TextView
        android:id="@+id/widget_lunar_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/calendar_v2_secondary"
        android:includeFontPadding="false" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:orientation="vertical"
    android:layout_weight="1">
    <LinearLayout
      android:id="@+id/widget_fasting_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:padding="4dp"
      android:layout_marginBottom="2dp"
      android:background="@drawable/calendar_v2_notice"
      android:visibility="gone">
      <ImageView
        android:id="@+id/widget_fasting_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/calendar_dot_fasting" />
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">
        <TextView
          android:id="@+id/widget_fasting"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/calendar_v2_text"
          android:includeFontPadding="false"
          android:textStyle="bold"
          android:maxLines="1"
          android:ellipsize="end" />
        <TextView
          android:id="@+id/widget_fasting_detail"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="11sp"
          android:textColor="@color/calendar_v2_secondary"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:ellipsize="end" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:id="@+id/widget_tho_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:padding="4dp"
      android:layout_marginBottom="2dp"
      android:background="@drawable/calendar_v2_notice"
      android:visibility="gone">
      <ImageView
        android:id="@+id/widget_tho_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/calendar_dot_tho" />
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">
        <TextView
          android:id="@+id/widget_tho"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/calendar_v2_text"
          android:includeFontPadding="false"
          android:textStyle="bold"
          android:maxLines="1"
          android:ellipsize="end" />
        <TextView
          android:id="@+id/widget_tho_detail"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="11sp"
          android:textColor="@color/calendar_v2_secondary"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:ellipsize="end" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:id="@+id/widget_holiday_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:padding="4dp"
      android:layout_marginBottom="2dp"
      android:background="@drawable/calendar_v2_notice"
      android:visibility="gone">
      <ImageView
        android:id="@+id/widget_holiday_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/calendar_dot_holiday" />
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">
        <TextView
          android:id="@+id/widget_holiday"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/calendar_v2_text"
          android:includeFontPadding="false"
          android:textStyle="bold"
          android:maxLines="1"
          android:ellipsize="end" />
        <TextView
          android:id="@+id/widget_holiday_detail"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="11sp"
          android:textColor="@color/calendar_v2_secondary"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:ellipsize="end" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:id="@+id/widget_personal_card"
      android:visibility="gone">
      <TextView
        android:id="@+id/widget_personal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/calendar_v2_text"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp" />
      <LinearLayout
        android:id="@+id/widget_personal_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/calendar_v2_notice"
        android:visibility="gone">
        <ImageView
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:src="@drawable/calendar_dot_personal"
          android:importantForAccessibility="no"
          android:layout_marginEnd="5dp" />
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_weight="1">
          <TextView
            android:id="@+id/widget_personal_one_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/calendar_v2_text"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
          <TextView
            android:id="@+id/widget_personal_one_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/calendar_v2_secondary"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout
        android:id="@+id/widget_personal_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/calendar_v2_notice"
        android:visibility="gone">
        <ImageView
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:src="@drawable/calendar_dot_personal"
          android:importantForAccessibility="no"
          android:layout_marginEnd="5dp" />
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_weight="1">
          <TextView
            android:id="@+id/widget_personal_two_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/calendar_v2_text"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
          <TextView
            android:id="@+id/widget_personal_two_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/calendar_v2_secondary"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
        </LinearLayout>
      </LinearLayout>
      <TextView
        android:id="@+id/widget_personal_overflow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/calendar_v2_text"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
    </LinearLayout>
    <TextView
      android:id="@+id/widget_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textSize="11sp"
      android:textColor="@color/calendar_v2_text"
      android:includeFontPadding="false"
      android:text="@string/calendar_widget_no_events"
      android:maxLines="2"
      android:ellipsize="end"
      android:visibility="gone" />
    <TextView
      android:id="@+id/widget_upcoming_heading"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textSize="11sp"
      android:textColor="@color/calendar_v2_text"
      android:includeFontPadding="false"
      android:text="@string/calendar_widget_upcoming_heading"
      android:textStyle="bold"
      android:layout_marginTop="5dp"
      android:layout_marginBottom="3dp" />
    <LinearLayout
      android:id="@+id/widget_upcoming"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:gravity="center_vertical"
      android:padding="5dp"
      android:background="@drawable/calendar_v2_notice">
      <TextView
        android:id="@+id/widget_upcoming_date"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/calendar_v2_text"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:maxLines="1" />
      <ImageView
        android:id="@+id/widget_upcoming_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="5dp"
        android:importantForAccessibility="no" />
      <ImageView
        android:importantForAccessibility="no"
        android:visibility="gone"
        android:src="@drawable/calendar_dot_personal"
        android:layout_marginEnd="5dp"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:id="@+id/widget_upcoming_personal_icon" />
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">
        <TextView
          android:id="@+id/widget_upcoming_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="13sp"
          android:textColor="@color/calendar_v2_text"
          android:includeFontPadding="false"
          android:textStyle="bold"
          android:maxLines="2"
          android:ellipsize="end" />
        <TextView
          android:id="@+id/widget_upcoming_lunar"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="11sp"
          android:textColor="@color/calendar_v2_text"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:ellipsize="end" />
      </LinearLayout>
      <TextView
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textColor="@color/calendar_v2_text"
        android:includeFontPadding="false"
        android:text="@string/calendar_widget_chevron"
        android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView
      android:id="@+id/widget_upcoming_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textSize="11sp"
      android:textColor="@color/calendar_v2_text"
      android:includeFontPadding="false"
      android:text="@string/calendar_widget_no_upcoming"
      android:maxLines="2"
      android:ellipsize="end"
      android:visibility="gone" />
  </LinearLayout>
  <TextView
    android:id="@+id/widget_open_today"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:textSize="13sp"
    android:textColor="@color/calendar_v2_text"
    android:includeFontPadding="false"
    android:text="@string/calendar_widget_open_today"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:layout_marginTop="5dp"
    android:background="@drawable/calendar_v2_footer" />
</LinearLayout>