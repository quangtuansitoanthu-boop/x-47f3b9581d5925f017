<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/practice_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="4dp" android:background="@drawable/practice_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/practice_widget_header" android:textSize="12sp" android:textStyle="bold"
            android:textColor="@color/practice_widget_text" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/practice_widget_summary" android:layout_width="96dp" android:layout_height="wrap_content"
            android:gravity="end" android:layout_marginStart="6dp" android:text="@string/practice_widget_missing_progress"
            android:textSize="11sp" android:textColor="@color/practice_widget_secondary" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/practice_widget_row_one" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="horizontal" />
    <LinearLayout android:id="@+id/practice_widget_row_two" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="horizontal" />
</LinearLayout>
