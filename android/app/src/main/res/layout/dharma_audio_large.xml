<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dharma_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/dharma_audio_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/dharma_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/dharma_audio_name" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/dharma_audio_text" android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/dharma_status" android:text="@string/dharma_audio_waiting" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/dharma_audio_secondary" android:includeFontPadding="false" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginTop="6dp">
        <ImageView android:id="@+id/dharma_cover" android:layout_width="64dp" android:layout_height="64dp"
            android:background="@drawable/dharma_audio_cover_frame" android:scaleType="centerCrop" android:clipToOutline="true" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:id="@+id/dharma_title" android:text="@string/dharma_audio_loading" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/dharma_audio_text"
                android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/dharma_artist" android:text="@string/dharma_audio_open" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/dharma_audio_secondary" android:includeFontPadding="false"
                android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
            <ProgressBar android:id="@+id/dharma_progress" android:visibility="gone" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp"
                android:progressTint="@color/dharma_audio_accent" android:progressBackgroundTint="@color/dharma_audio_track" />
            <TextView android:id="@+id/dharma_times" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/dharma_audio_secondary" android:includeFontPadding="false"
                android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/dharma_repeat" android:includeFontPadding="false" android:singleLine="true" android:maxLines="1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:minWidth="48dp" android:padding="0dp" android:textSize="23sp" android:textAllCaps="false"
            android:textColor="@color/dharma_audio_text" android:background="@android:color/transparent" />
        <Button android:id="@+id/dharma_back" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:minWidth="48dp" android:padding="0dp" android:background="@android:color/transparent" android:text="−15s"
            android:textSize="13sp" android:textAllCaps="false" android:textColor="@color/dharma_audio_text" android:contentDescription="@string/dharma_audio_back" />
        <ImageButton android:id="@+id/dharma_play" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/dharma_audio_play" android:background="@drawable/dharma_audio_button"
            android:contentDescription="@string/dharma_audio_play" />
        <Button android:id="@+id/dharma_forward" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:minWidth="48dp" android:padding="0dp" android:background="@android:color/transparent" android:text="+15s"
            android:textSize="13sp" android:textAllCaps="false" android:textColor="@color/dharma_audio_text" android:contentDescription="@string/dharma_audio_forward" />
        <Button android:id="@+id/dharma_sleep" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:minWidth="48dp" android:padding="0dp" android:textSize="11sp" android:textAllCaps="false" android:gravity="center"
            android:textColor="@color/dharma_audio_text" android:background="@android:color/transparent" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dharma_audio_border" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/dharma_queue_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/dharma_audio_queue" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/dharma_audio_text"
        android:includeFontPadding="false" android:layout_marginTop="6dp" />
    <LinearLayout android:id="@+id/dharma_next_1" android:visibility="gone" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:background="@drawable/dharma_audio_card" android:layout_marginTop="4dp">
        <ImageView android:id="@+id/dharma_next_1_cover" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/dharma_audio_cover_frame"
            android:scaleType="centerCrop" android:clipToOutline="true" android:importantForAccessibility="no" />
        <TextView android:id="@+id/dharma_next_1_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/dharma_audio_text"
            android:layout_marginStart="8dp" android:layout_marginEnd="6dp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/dharma_audio_queue_play" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/dharma_next_2" android:visibility="gone" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:background="@drawable/dharma_audio_card" android:layout_marginTop="4dp">
        <ImageView android:id="@+id/dharma_next_2_cover" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/dharma_audio_cover_frame"
            android:scaleType="centerCrop" android:clipToOutline="true" android:importantForAccessibility="no" />
        <TextView android:id="@+id/dharma_next_2_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/dharma_audio_text"
            android:layout_marginStart="8dp" android:layout_marginEnd="6dp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/dharma_audio_queue_play" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/dharma_next_3" android:visibility="gone" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:background="@drawable/dharma_audio_card" android:layout_marginTop="4dp">
        <ImageView android:id="@+id/dharma_next_3_cover" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/dharma_audio_cover_frame"
            android:scaleType="centerCrop" android:clipToOutline="true" android:importantForAccessibility="no" />
        <TextView android:id="@+id/dharma_next_3_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/dharma_audio_text"
            android:layout_marginStart="8dp" android:layout_marginEnd="6dp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/dharma_audio_queue_play" android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:id="@+id/dharma_empty_queue" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/dharma_audio_secondary" android:text="@string/dharma_audio_queue_empty"
        android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="4dp" />
</LinearLayout>





