<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="4dp"
  android:background="@drawable/calendar_widget_background">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical">
    <ImageView
      android:id="@+id/widget_title_icon"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:importantForAccessibility="no"
      android:layout_marginEnd="6dp" />
    <TextView
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:textSize="11sp"
      android:textColor="@color/calendar_v2_text"
      android:includeFontPadding="false"
      android:text="@string/calendar_widget_title_plain"
      android:textStyle="bold"
      android:maxLines="1"
      android:ellipsize="end" />
  </LinearLayout>
  <TextView
    android:id="@+id/widget_solar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="9sp"
    android:textColor="@color/calendar_v2_secondary"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_marginTop="2dp"
    android:textColorHint="@color/calendar_v2_secondary" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical">
    <LinearLayout
      android:layout_width="80dp"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
          android:id="@+id/widget_lunar_day"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textSize="28sp"
          android:textColor="@color/calendar_v2_day"
          android:includeFontPadding="false"
          android:fontFamily="serif"
          android:textStyle="bold"
          android:gravity="center"
          android:layout_gravity="center_horizontal" />
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">
          <TextView
            android:id="@+id/widget_lunar_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/calendar_v2_text"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center" />
          <TextView
            android:id="@+id/widget_lunar_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/calendar_v2_secondary"
            android:includeFontPadding="false"
            android:gravity="center" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_weight="1"
      android:layout_marginStart="6dp">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
          android:id="@+id/widget_dot_row_one"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp">
          <LinearLayout
            android:id="@+id/widget_fasting_indicator"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginEnd="3dp"
            android:visibility="gone">
            <ImageView
              android:id="@+id/widget_dot_fasting"
              android:layout_width="8dp"
              android:layout_height="8dp"
              android:src="@drawable/calendar_dot_fasting"
              android:importantForAccessibility="no"
              android:layout_marginEnd="4dp" />
            <TextView
              android:id="@+id/widget_fasting"
              android:layout_width="0dp"
              android:layout_weight="1"
              android:layout_height="wrap_content"
              android:textSize="9sp"
              android:textColor="@color/calendar_v2_text"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:ellipsize="end" />
          </LinearLayout>
          <LinearLayout
            android:id="@+id/widget_tho_indicator"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginEnd="3dp"
            android:visibility="gone">
            <ImageView
              android:id="@+id/widget_dot_tho"
              android:layout_width="8dp"
              android:layout_height="8dp"
              android:src="@drawable/calendar_dot_tho"
              android:importantForAccessibility="no"
              android:layout_marginEnd="4dp" />
            <TextView
              android:id="@+id/widget_tho"
              android:layout_width="0dp"
              android:layout_weight="1"
              android:layout_height="wrap_content"
              android:textSize="9sp"
              android:textColor="@color/calendar_v2_text"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:ellipsize="end" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout
          android:id="@+id/widget_dot_row_two"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp">
          <LinearLayout
            android:id="@+id/widget_holiday_indicator"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginEnd="3dp"
            android:visibility="gone">
            <ImageView
              android:id="@+id/widget_dot_holiday"
              android:layout_width="8dp"
              android:layout_height="8dp"
              android:src="@drawable/calendar_dot_holiday"
              android:importantForAccessibility="no"
              android:layout_marginEnd="4dp" />
            <TextView
              android:id="@+id/widget_holiday"
              android:layout_width="0dp"
              android:layout_weight="1"
              android:layout_height="wrap_content"
              android:textSize="9sp"
              android:textColor="@color/calendar_v2_text"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:ellipsize="end" />
          </LinearLayout>
          <LinearLayout
            android:id="@+id/widget_personal_indicator"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginEnd="3dp"
            android:visibility="gone">
            <ImageView
              android:id="@+id/widget_dot_personal"
              android:layout_width="8dp"
              android:layout_height="8dp"
              android:src="@drawable/calendar_dot_personal"
              android:importantForAccessibility="no"
              android:layout_marginEnd="4dp" />
            <TextView
              android:id="@+id/widget_personal"
              android:layout_width="0dp"
              android:layout_weight="1"
              android:layout_height="wrap_content"
              android:textSize="9sp"
              android:textColor="@color/calendar_v2_text"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:ellipsize="end" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout
          android:id="@+id/widget_personal_first_row"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:padding="4dp"
          android:layout_marginTop="5dp"
          android:background="@drawable/calendar_v2_notice"
          android:visibility="gone">
          <TextView
            android:id="@+id/widget_personal_first"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="@color/calendar_v2_text"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
          <TextView
            android:id="@+id/widget_personal_first_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textColor="@color/calendar_v2_text"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:layout_marginStart="3dp" />
        </LinearLayout>
      </LinearLayout>
      <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textColor="@color/calendar_v2_text"
        android:includeFontPadding="false"
        android:text="@string/calendar_widget_no_events"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>