{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quangtu-sveltekit-local",
  "main": "../../dist-sveltekit/_worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../../dist-sveltekit",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/oauth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quangtu-db-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "quangtu-local"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "9127001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "COMMENT_RATE_LIMITER",
      "namespace_id": "9127002",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "VIEW_RATE_LIMITER",
      "namespace_id": "9127003",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "9127004",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "PRESENCE_RATE_LIMITER",
      "namespace_id": "9127005",
      "simple": { "limit": 1000, "period": 60 }
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "SESSION_SECRET": "e2e-session-secret-with-enough-entropy",
    "OAUTH_STATE_SECRET": "e2e-oauth-state-secret-with-enough-entropy",
    "RATE_LIMIT_SALT": "e2e-rate-limit-salt",
    "MEDIA_PUBLIC_BASE_URL": "/api/media",
    "GOOGLE_DRIVE_ROOT_FOLDER_ID": "1F-14nA9PVLmh20gIVW-zHfa-hXbWko-y",
    "PRESENCE_ENABLED": "true",
    "PRACTICE_COMMUNITY_ENABLED": "true",
    "ENVIRONMENT": "local"
  }
}
