{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/app.d.ts",
    "src/lib/browser/**/*.ts",
    "src/lib/contracts/**/*.ts",
    "src/routes/**/*.svelte",
    "src/routes/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/parity/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "src/lib/server/**/*",
    "tests/component/**/*"
  ]
}
